<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>KarouselOverviewConfig</class>
 <widget class="QWidget" name="KarouselOverviewConfig">
  <layout class="QFormLayout" name="formLayout">
   <item row="0" column="0">
    <widget class="QLabel" name="labelRowHeight">
     <property name="text">
      <string>Desktop row height:</string>
     </property>
     <property name="buddy">
      <cstring>kcfg_RowHeight</cstring>
     </property>
    </widget>
   </item>
   <item row="0" column="1">
    <widget class="QSpinBox" name="kcfg_RowHeight">
     <property name="toolTip">
      <string>Height of a desktop row, in percent of the screen height</string>
     </property>
     <property name="suffix">
      <string>%</string>
     </property>
     <property name="minimum">
      <number>20</number>
     </property>
     <property name="maximum">
      <number>90</number>
     </property>
     <property name="singleStep">
      <number>5</number>
     </property>
     <property name="value">
      <number>50</number>
     </property>
    </widget>
   </item>
   <item row="1" column="0">
    <widget class="QLabel" name="labelWindows">
     <property name="text">
      <string>Windows:</string>
     </property>
    </widget>
   </item>
   <item row="1" column="1">
    <widget class="QCheckBox" name="kcfg_CenterOnClick">
     <property name="text">
      <string>Center the clicked window</string>
     </property>
     <property name="toolTip">
      <string>Clicking a window scrolls it to the middle of the screen, otherwise Karousel only scrolls as far as needed to show it</string>
     </property>
    </widget>
   </item>
   <item row="2" column="0">
    <widget class="QLabel" name="labelShow">
     <property name="text">
      <string>Show:</string>
     </property>
    </widget>
   </item>
   <item row="2" column="1">
    <widget class="QCheckBox" name="kcfg_ShowIcons">
     <property name="text">
      <string>App icons</string>
     </property>
    </widget>
   </item>
   <item row="3" column="1">
    <widget class="QCheckBox" name="kcfg_ShowTitles">
     <property name="text">
      <string>Window titles</string>
     </property>
    </widget>
   </item>
   <item row="4" column="1">
    <widget class="QCheckBox" name="kcfg_ShowMinimized">
     <property name="text">
      <string>Minimized windows</string>
     </property>
     <property name="toolTip">
      <string>Minimized windows are shown dimmed at the end of their desktop, click one to restore it</string>
     </property>
    </widget>
   </item>
   <item row="5" column="1">
    <widget class="QCheckBox" name="kcfg_BlurBehindWindows">
     <property name="text">
      <string>Blur behind windows</string>
     </property>
     <property name="toolTip">
      <string>Blurs the wallpaper behind translucent windows, like KWin's blur effect does on the desktop</string>
     </property>
    </widget>
   </item>
   <item row="6" column="0">
    <widget class="QLabel" name="labelDesktops">
     <property name="text">
      <string>Desktops:</string>
     </property>
    </widget>
   </item>
   <item row="6" column="1">
    <widget class="QCheckBox" name="kcfg_ShowNewDesktopRow">
     <property name="text">
      <string>"New desktop" row</string>
     </property>
     <property name="toolTip">
      <string>A row after the last desktop, click it or drop a window on it to create a desktop; without it, drop a window between two desktops or after the last one</string>
     </property>
    </widget>
   </item>
   <item row="7" column="1">
    <widget class="QCheckBox" name="kcfg_RemoveEmptyDesktops">
     <property name="text">
      <string>Remove empty desktops created here when closing</string>
     </property>
     <property name="toolTip">
      <string>Like GNOME's dynamic workspaces, but only for desktops created in the overview, your other desktops stay: those without windows go away when the overview closes, except the current one</string>
     </property>
    </widget>
   </item>
   <item row="8" column="0">
    <widget class="QLabel" name="labelGesture">
     <property name="text">
      <string>Touchpad gesture:</string>
     </property>
    </widget>
   </item>
   <item row="8" column="1">
    <widget class="QCheckBox" name="kcfg_TouchpadGesture">
     <property name="text">
      <string>Swipe up to open, down to close</string>
     </property>
     <property name="toolTip">
      <string>With 4 fingers, this clashes with Plasma's own Overview effect, which uses the same gesture</string>
     </property>
    </widget>
   </item>
   <item row="9" column="0">
    <widget class="QLabel" name="labelFingers">
     <property name="text">
      <string>Fingers:</string>
     </property>
     <property name="buddy">
      <cstring>kcfg_GestureFingerCount</cstring>
     </property>
    </widget>
   </item>
   <item row="9" column="1">
    <widget class="QSpinBox" name="kcfg_GestureFingerCount">
     <property name="minimum">
      <number>3</number>
     </property>
     <property name="maximum">
      <number>4</number>
     </property>
     <property name="value">
      <number>3</number>
     </property>
    </widget>
   </item>
   <item row="10" column="0" colspan="2">
    <widget class="QLabel" name="labelScreenEdges">
     <property name="text">
      <string>Screen edges that toggle the overview can be set in System Settings, under Screen Edges.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
